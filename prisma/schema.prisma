// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  FREELANCER
  ADMIN
}

enum ProviderType {
  INDIVIDUAL
  GROUP
}

model User {
  id             Int      @id @default(autoincrement())
  fullName       String
  email          String   @unique
  passwordHash   String
  phone          String?
  role           Role     @default(CLIENT)
  location       String?
  profilePicture String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  clientProfile     ClientProfile?
  freelancerProfile FreelancerProfile?
  raisedDisputes    Dispute[]          @relation("DisputeRaisedBy")
  reviewsWritten    Review[]           @relation("ReviewWriter")
  reviewsReceived   Review[]           @relation("ReviewReceiver")
  messages          Message[]
  notifications     Notification[]
}

model ClientProfile {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  user      User       @relation(fields: [userId], references: [id])
  events    Event[]
  bookings  Booking[]
  favorites Favorite[]
}

model FreelancerProfile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  user            User     @relation(fields: [userId], references: [id])
  bio             String?
  experienceYears Int?
  hourlyRate      Decimal?
  latitude        Decimal?
  longitude       Decimal?
  rating          Float    @default(0.0)
  totalReviews    Int      @default(0)
  isVerified      Boolean      @default(false)
  providerType    ProviderType @default(INDIVIDUAL)
  teamSize        Int?         @default(1)
  createdAt       DateTime     @default(now())

  certifications Certification[]
  education      Education[]
  portfolioItems PortfolioItem[]
  services       FreelancerService[]
  availability   Availability[]
  proposals      Proposal[]
  bookings       Booking[]
  favorites      Favorite[]
}

model Certification {
  id                  Int               @id @default(autoincrement())
  freelancerId        Int
  freelancer          FreelancerProfile @relation(fields: [freelancerId], references: [id])
  title               String
  issuingOrganization String
  credentialUrl       String?
  issuedYear          Int
}

model Education {
  id              Int               @id @default(autoincrement())
  freelancerId    Int
  freelancer      FreelancerProfile @relation(fields: [freelancerId], references: [id])
  degreeName      String
  institutionName String
}

model PortfolioItem {
  id           Int               @id @default(autoincrement())
  freelancerId Int
  freelancer   FreelancerProfile @relation(fields: [freelancerId], references: [id])
  title        String
  mediaUrl     String
  description  String?
}

model Category {
  id               Int        @id @default(autoincrement())
  parentCategoryId Int?
  parentCategory   Category?  @relation("SubCategories", fields: [parentCategoryId], references: [id])
  subCategories    Category[] @relation("SubCategories")
  name             String
  iconUrl          String?

  services    FreelancerService[]
  jobPostings JobPosting[]
}

model FreelancerService {
  id           Int               @id @default(autoincrement())
  freelancerId Int
  freelancer   FreelancerProfile @relation(fields: [freelancerId], references: [id])
  categoryId   Int
  category     Category          @relation(fields: [categoryId], references: [id])
  price        Decimal
  description  String
  isActive     Boolean           @default(true)
}

enum EventStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Event {
  id        Int           @id @default(autoincrement())
  clientId  Int
  client    ClientProfile @relation(fields: [clientId], references: [id])
  title     String
  eventType String
  eventDate DateTime      @db.Date
  venue     String?
  city      String?
  budget    Decimal?
  status    EventStatus   @default(DRAFT)

  jobPostings JobPosting[]
  bookings    Booking[]
}

enum JobStatus {
  OPEN
  CLOSED
  FILLED
}

model JobPosting {
  id          Int       @id @default(autoincrement())
  eventId     Int
  event       Event     @relation(fields: [eventId], references: [id])
  categoryId  Int
  category    Category  @relation(fields: [categoryId], references: [id])
  description String
  budget      Decimal?
  deadline    DateTime  @db.Date
  status      JobStatus @default(OPEN)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  proposals Proposal[]
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Proposal {
  id           Int               @id @default(autoincrement())
  jobId        Int
  job          JobPosting        @relation(fields: [jobId], references: [id])
  freelancerId Int
  freelancer   FreelancerProfile @relation(fields: [freelancerId], references: [id])
  bidAmount    Decimal
  message      String
  status       ProposalStatus    @default(PENDING)
  createdAt    DateTime          @default(now())

  booking      Booking?
  conversation Conversation?
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Booking {
  id           Int               @id @default(autoincrement())
  proposalId   Int               @unique
  proposal     Proposal          @relation(fields: [proposalId], references: [id])
  eventId      Int
  event        Event             @relation(fields: [eventId], references: [id])
  freelancerId Int
  freelancer   FreelancerProfile @relation(fields: [freelancerId], references: [id])
  clientId     Int
  client       ClientProfile     @relation(fields: [clientId], references: [id])
  totalAmount  Decimal
  status       BookingStatus     @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  payments Payment[]
  disputes Dispute[]
  reviews  Review[]
}

enum PaymentType {
  DEPOSIT
  INSTALLMENT
  FINAL
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Payment {
  id            Int           @id @default(autoincrement())
  bookingId     Int
  booking       Booking       @relation(fields: [bookingId], references: [id])
  amount        Decimal
  paymentType   PaymentType
  paymentMethod String
  paymentStatus PaymentStatus @default(PENDING)
  transactionId String?
  createdAt     DateTime      @default(now())
}

enum DisputeStatus {
  OPEN
  RESOLVED
  CLOSED
}

model Dispute {
  id         Int           @id @default(autoincrement())
  bookingId  Int
  booking    Booking       @relation(fields: [bookingId], references: [id])
  raisedById Int
  raisedBy   User          @relation("DisputeRaisedBy", fields: [raisedById], references: [id])
  reason     String
  status     DisputeStatus @default(OPEN)
  createdAt  DateTime      @default(now())
  resolvedAt DateTime?
}

enum ReviewType {
  CLIENT_TO_FREELANCER
  FREELANCER_TO_CLIENT
}

model Review {
  id         Int        @id @default(autoincrement())
  bookingId  Int
  booking    Booking    @relation(fields: [bookingId], references: [id])
  reviewerId Int
  reviewer   User       @relation("ReviewWriter", fields: [reviewerId], references: [id])
  revieweeId Int
  reviewee   User       @relation("ReviewReceiver", fields: [revieweeId], references: [id])
  reviewType ReviewType
  rating     Int
  comment    String?
  createdAt  DateTime   @default(now())
}

model Conversation {
  id         Int      @id @default(autoincrement())
  proposalId Int      @unique
  proposal   Proposal @relation(fields: [proposalId], references: [id])

  messages Message[]
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       Int
  sender         User         @relation(fields: [senderId], references: [id])
  message        String
  sentAt         DateTime     @default(now())
}

model Availability {
  id            Int               @id @default(autoincrement())
  freelancerId  Int
  freelancer    FreelancerProfile @relation(fields: [freelancerId], references: [id])
  availableDate DateTime          @db.Date
  isAvailable   Boolean           @default(true)
}

model Favorite {
  id           Int               @id @default(autoincrement())
  clientId     Int
  client       ClientProfile     @relation(fields: [clientId], references: [id])
  freelancerId Int
  freelancer   FreelancerProfile @relation(fields: [freelancerId], references: [id])
  createdAt    DateTime          @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  type      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
